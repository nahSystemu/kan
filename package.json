{
  "name": "kan",
  "private": true,
  "engines": {
    "node": ">=20.18.1",
    "pnpm": "^9.14.2"
  },
  "packageManager": "pnpm@9.14.2",
  "scripts": {
    "build": "turbo run --filter=!@kan/docs build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "db:migrate": "cd packages/db && pnpm migrate",
    "db:generate": "cd packages/db && pnpm generate",
    "db:push": "turbo -F @kan/db push",
    "db:studio": "turbo -F @kan/db studio",
    "dev": "turbo watch dev --continue",
    "dev:next": "turbo watch dev -F @kan/web...",
    "format": "turbo run --filter=!@kan/docs format --continue -- --cache --cache-location .cache/.prettiercache",
    "format:fix": "turbo run --filter=!@kan/docs format --continue -- --write --cache --cache-location .cache/.prettiercache",
    "lint": "turbo run --filter=!@kan/docs lint --continue -- --cache --cache-location .cache/.eslintcache",
    "lint:fix": "turbo run --filter=!@kan/docs lint --continue -- --fix --cache --cache-location .cache/.eslintcache",
    "lint:ws": "pnpm dlx sherif@latest",
    "postinstall": "pnpm lint:ws",
    "typecheck": "turbo run --filter=!@kan/docs typecheck",
    "ui-add": "turbo run ui-add"
  },
  "devDependencies": {
    "@kan/prettier-config": "workspace:*",
    "@turbo/gen": "^2.3.1",
    "prettier": "catalog:",
    "turbo": "^2.3.1",
    "typescript": "catalog:"
  },
  "prettier": "@kan/prettier-config",
  "pnpm": {
    "overrides": {
      "@types/minimatch": "npm:minimatch@*",
      "@types/glob": "npm:@types/glob@^8.1.0"
    },
    "//supportedArchitectures": "The Docker image builds the Next bundle once on the build host and ships it to both linux/amd64 and linux/arm64 runtime images. sharp (a transitive dep of next, used by next/image) resolves a prebuilt binary per architecture, so the install must fetch every Linux variant or the arm64 image ends up holding x64 binaries. 'current' keeps local development installs working on any platform.",
    "supportedArchitectures": {
      "os": ["linux", "current"],
      "cpu": ["x64", "arm64", "current"],
      "libc": ["glibc", "musl", "current"]
    }
  }
}
